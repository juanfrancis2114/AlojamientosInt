{
  "name": "booking-prototipo-alojamientos",
  "version": "1.0.0",
  "description": "Kawsay Estancias: marketplace y ERP de alojamientos de Ecuador",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && vite build && node scripts/copy-swagger.cjs",
    "build:api": "nest build",
    "dev:web": "vite",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint frontend/src src/main.ts src/common/origins.ts src/modules/alojamientos test/unit",
    "test:unit": "npm run build:api && vitest run",
    "test:api": "npm run build && node test/integration.cjs",
    "test:postgres": "node test/postgres-schema.cjs",
    "test:browser": "npm run build && node test/browser.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "db:schema": "npm run build && node scripts/schema.cjs",
    "check": "tsc --noEmit",
    "deploy:configure": "node scripts/configure-vercel.cjs",
    "db:catalog": "npm run build:api && node scripts/expand-catalog.cjs",
    "test:catalog": "npm run build:api && node test/catalog.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bootstrap": "^5.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "pg": "^8.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sql.js": "^1.14.2",
    "typeorm": "^0.3.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.1",
    "vercel": "^62.2.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "^5.4.1"
  }
}
